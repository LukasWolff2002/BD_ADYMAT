<button type="button" id="toggle-selection-mode" style="margin-bottom: 10px;">
  Escanear QR de maquinaria
</button>

<!-- Selección manual -->
<div id="select_machinery_section">
  <%= form.label :machinery_id, "Maquinaria" %>
  <%= form.collection_select :machinery_id, Machinery.all, :id, :nombre, { prompt: "Seleccione una maquinaria" }, { id: "rental_machinery_id" } %>
</div>

<!-- Escaneo QR -->
<div id="qr_machinery_section" style="display: none;">
  <label>Escanear código QR:</label>
  <div id="qr-reader" style="width: 300px;"></div>
  <div id="qr-result" style="color: green; font-weight: bold;"></div>
</div>

<div>
  <%= form.label :start_date, "Fecha de inicio" %>
  <%= form.date_field :start_date %>
</div>

<div>
  <%= form.label :end_date, "Fecha de término" %>
  <%= form.date_field :end_date %>
</div>

<div>
  <%= form.label :tarifa %>
  <%= form.select :rate, ["Día", "Semana", "Mes"], prompt: "Seleccione una tarifa" %>
</div>

<div>
  <%= form.label :discount, "Descuento (%)" %>
  <%= form.number_field :discount, step: 0.01, min: 0, id: "rental_discount" %>
</div>

<div>
  <%= form.label :freight, "Flete ($)" %>
  <%= form.number_field :freight, step: 0.01, min: 0, id: "rental_freight" %>
</div>

<div>
  <%= form.label :total_amount, "Total" %>
  <%= form.number_field :total_amount, step: 0.01, readonly: true, style: "background-color: #f9f9f9;", id: "rental_total_amount" %>
</div>

<!-- Scripts -->
<script src="https://unpkg.com/html5-qrcode" type="text/javascript"></script>
<script>
  document.addEventListener("DOMContentLoaded", function () {
    const startDateInput = document.querySelector("#rental_start_date");
    const endDateInput = document.querySelector("#rental_end_date");
    const machinerySelect = document.querySelector("#rental_machinery_id");
    const warningDiv = document.getElementById("rental_warning");
    const rateSelect = document.querySelector("#rental_rate");
    const discountInput = document.querySelector("#rental_discount");
    const freightInput = document.querySelector("#rental_freight");
    const totalInput = document.querySelector("#rental_total_amount");

    // Alternar entre selección manual y QR
    const toggleButton = document.getElementById("toggle-selection-mode");
    const selectSection = document.getElementById("select_machinery_section");
    const qrSection = document.getElementById("qr_machinery_section");

    toggleButton.addEventListener("click", () => {
      const usingQR = qrSection.style.display === "block";

      if (usingQR) {
        // Cambiar a selección manual
        qrSection.style.display = "none";
        selectSection.style.display = "block";
        toggleButton.textContent = "Escanear QR de maquinaria";
      } else {
        // Cambiar a escaneo QR
        selectSection.style.display = "none";
        qrSection.style.display = "block";
        toggleButton.textContent = "Seleccionar maquinaria";
      }
    });

    // Horas disponibles por maquinaria
    const machineryHoursMap = {
      <% Machinery.all.each do |m| %>
        "<%= m.id %>": <%= m.horas_disponibles || 0 %>,
      <% end %>
    };

    // Tarifas por maquinaria
    const machineryRates = {
      <% Machinery.all.each do |m| %>
        "<%= m.id %>": {
          dia: <%= m.valor_dia || 0 %>,
          semana: <%= m.valor_semana || 0 %>,
          mes: <%= m.valor_mes || 0 %>
        },
      <% end %>
    };

    // Verificar si se exceden las horas disponibles
    function checkRentalHours() {
      const startDate = new Date(startDateInput.value);
      const endDate = new Date(endDateInput.value);
      const machineryId = machinerySelect.value;

      if (!startDate || !endDate || !machineryId) {
        warningDiv.textContent = "";
        return;
      }

      const days = Math.floor((endDate - startDate) / (1000 * 60 * 60 * 24)) + 1;
      const totalHours = days * 8;
      const availableHours = machineryHoursMap[machineryId];

      if (totalHours > availableHours) {
        warningDiv.textContent = `⚠️ El arriendo requiere ${totalHours}h pero la maquinaria solo tiene ${availableHours}h disponibles.`;
      } else {
        warningDiv.textContent = "";
      }
    }

    // Calcular total del arriendo
    function calculateRentalTotal() {
      const machineryId = machinerySelect.value;
      const rate = rateSelect.value;
      const startDate = new Date(startDateInput.value);
      const endDate = new Date(endDateInput.value);
      const discount = parseFloat(discountInput.value) || 0;
      const freight = parseFloat(freightInput.value) || 0;

      if (!machineryId || !rate || !startDateInput.value || !endDateInput.value) {
        totalInput.value = "";
        return;
      }

      const rates = machineryRates[machineryId];
      if (!rates) return;

      const days = Math.floor((endDate - startDate) / (1000 * 60 * 60 * 24)) + 1;

      let units;
      if (rate === "Día") {
        units = days;
      } else if (rate === "Semana") {
        units = Math.ceil(days / 7);
      } else if (rate === "Mes") {
        units = Math.ceil(days / 30);
      } else {
        totalInput.value = "";
        return;
      }

      const rateMap = { "Día": "dia", "Semana": "semana", "Mes": "mes" };
      const baseRate = rates[rateMap[rate]] || 0;
      const subtotal = units * baseRate;
      const discountAmount = subtotal * (discount / 100);
      const total = subtotal - discountAmount + freight;

      totalInput.value = total.toFixed(2);
    }

    // Escaneo QR
    function onScanSuccess(decodedText) {
      let token = decodedText;

      try {
        const url = new URL(decodedText);
        token = url.pathname.split("/").pop();
      } catch (e) {
        // No es URL, usar directamente
      }

      fetch(`/maquinarias/buscar_por_qr?qr_token=${token}`)
        .then(response => response.json())
        .then(data => {
          if (data.id) {
            machinerySelect.value = data.id;
            machinerySelect.dispatchEvent(new Event("change"));
            document.getElementById("qr-result").innerText = `✅ Maquinaria seleccionada: ${data.nombre}`;
            toggleButton.textContent = "Seleccionar maquinaria";
            selectSection.style.display = "none";
            qrSection.style.display = "block";
            calculateRentalTotal();
          } else {
            document.getElementById("qr-result").innerText = "⚠️ Código QR no válido o maquinaria no encontrada.";
          }
        })
        .catch(() => {
          document.getElementById("qr-result").innerText = "⚠️ Error al buscar maquinaria.";
        });
    }

    const qrScanner = new Html5QrcodeScanner("qr-reader", { fps: 10, qrbox: 250 });
    qrScanner.render(onScanSuccess);

    // Eventos para recalcular
    [startDateInput, endDateInput, machinerySelect, rateSelect, discountInput, freightInput].forEach(input => {
      if (input) {
        input.addEventListener("change", () => {
          checkRentalHours();
          calculateRentalTotal();
        });
        input.addEventListener("input", calculateRentalTotal);
      }
    });
  });
</script>
